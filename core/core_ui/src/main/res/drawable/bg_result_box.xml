<?xml version="1.0" encoding="utf-8"?>
<!-- File: drawable/button_3d_orange.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">



    <!-- Top Inner Shadow Layer -->
    <item android:bottom="8dp" android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FFD39A" />
        </shape>
    </item>

    <!-- Bottom Inner Shadow Layer -->
    <item android:bottom="8dp" android:top="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#BF7D28" />
        </shape>
    </item>

    <!-- Main Orange Background -->
    <item android:top="5dp" android:bottom="12dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FFA736" />
        </shape>
    </item>
    <!-- Red Stroke Outline -->
    <item android:top="0dp" android:bottom="7dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#000000" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
