<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/detailSimulasi"
    android:orientation="vertical"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:theme="@style/Theme.PintuLogika"
    tools:context=".ui.SimulasiDetailActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" >

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:minHeight="?attr/actionBarSize">

            <ImageButton
                android:id="@+id/btnBackSimulasi"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:maxHeight="60dp"
                android:maxWidth="60dp"
                android:paddingBottom="10dp"
                android:src="@drawable/ic_arrow_back_24"
                android:background="@drawable/bg_button_3d_small_with_black_stroke"/>


            <TextView
                android:id="@+id/tvJudul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIMULASI LOGIKA AND"
                android:textStyle="bold"
                android:textSize="18sp"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_medium" />


        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>


    <TextView
        android:id="@+id/tvLogicExplanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:layout_marginTop="64dp"
        android:fontFamily="@font/poppins_medium" />



    <LinearLayout
        android:id="@+id/layout_simulasi"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appbar_simulasi">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Switch
                android:id="@+id/switch1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:thumb="@drawable/custom_switch_thumb"
                android:track="@drawable/custom_switch_track"
                style="@style/Widget.AppCompat.CompoundButton.Switch"
                tools:ignore="UseSwitchCompatOrMaterialXml"/>

            <Switch
                android:id="@+id/switch2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:thumb="@drawable/custom_switch_thumb"
                android:track="@drawable/custom_switch_track"
                style="@style/Widget.AppCompat.CompoundButton.Switch"
                tools:ignore="UseSwitchCompatOrMaterialXml"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/imgGerbang"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:src="@drawable/ic_gate_and" />

        <ImageView
            android:id="@+id/imgLamp"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="18dp"
            android:src="@drawable/ic_lamp_off" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTabelLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TABEL KEBENARAN"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_simulasi"/>

        <TableLayout
            android:id="@+id/tableTruth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:background="#EEE"
            android:textAlignment="center"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTabelLabel"/>

    </LinearLayout>



</LinearLayout>