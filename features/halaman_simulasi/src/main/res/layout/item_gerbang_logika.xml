<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:cardCornerRadius="16dp"
    card_view:cardElevation="4dp">

    <!-- Gunakan FrameLayout agar bisa mengatur layering -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- bg_circle_radial_gradient sebagai background paling bawah -->
        <View
            android:layout_width="wrap_content"
            android:layout_height="150dp"
            android:minHeight="150dp"
            android:background="@drawable/bg_circle_radial_gradient" />

        <!-- bg_orange_circle_shape di atas gradient -->
        <View
            android:layout_width="200dp"
            android:layout_height="125dp"
            android:layout_gravity="center_horizontal"
            android:translationY="-50dp"
            android:background="@drawable/bg_orange_light_circle_shape"
            android:backgroundTint="#90FFCE90"/>

        <!-- Konten utama -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center">

            <!-- Lingkaran putih dengan ikon -->
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_white_circle"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/imgGerbangLogika"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_gate_and" />
            </FrameLayout>

            <TextView
                android:id="@+id/namaGerbang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOGIKA AND"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/deskripsiGerbang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lorem ipsum dolor sit amet Lorem ipsum dolor sit ametLorem ipsum dolor sit ametLorem ipsum dolor sit ametLorem ipsum dolor sit ametLorem ipsum dolor sit amet..."
                android:lines="2"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:maxLines="2" />
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
