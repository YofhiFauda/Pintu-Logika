<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    tools:context=".gerbang_logika.DetailKuisGerbangLogikaActivity">

    <LinearLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:translationZ="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_button_3d_small_with_black_stroke"
            android:contentDescription="Back Button Simulasi"
            android:maxHeight="60dp"
            android:maxWidth="60dp"
            android:paddingBottom="10dp"
            android:src="@drawable/ic_home_24" />

        <LinearLayout
            android:id="@+id/layout_Output"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginHorizontal="20dp"
            android:layout_weight="1"
            android:background="@drawable/final_gate_background"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/output_dot1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/red_dot_indicator_stroke" />
            <View
                android:id="@+id/output_dot2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/red_dot_indicator_stroke" />
            <View
                android:id="@+id/output_dot3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/red_dot_indicator_stroke" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_button_3d_small_with_black_stroke"
            android:contentDescription="Back Button Simulasi"
            android:maxHeight="60dp"
            android:maxWidth="60dp"
            android:paddingBottom="10dp"
            android:src="@drawable/ic_reftesh_24" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/manual_level_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appbar"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <com.digitallogic.halaman_kuis.ConnectorView
        android:id="@+id/connectorLines"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:translationZ="15dp"
        android:elevation="1dp"
        android:layout_marginBottom="64dp"
        android:layout_gravity="center" />


</androidx.constraintlayout.widget.ConstraintLayout>