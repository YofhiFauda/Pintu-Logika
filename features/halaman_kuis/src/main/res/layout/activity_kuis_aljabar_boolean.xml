<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white"
    android:theme="@style/Theme.PintuLogika"
    android:layout_margin="16dp">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:minHeight="?attr/actionBarSize">

            <ImageButton
                android:id="@+id/btnBackSimulasi"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:maxHeight="60dp"
                android:maxWidth="60dp"
                android:paddingBottom="10dp"
                android:src="@drawable/ic_arrow_back_24"
                android:background="@drawable/bg_button_3d_small_with_black_stroke" />

            <TextView
                android:id="@+id/tvJudul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIMULASI LOGIKA AND"
                android:textStyle="bold"
                android:textSize="18sp"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_medium" />

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appbar"
        android:layout_marginTop="20dp"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <!-- Kode Soal -->
            <TextView
                android:id="@+id/tvScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="342512"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:gravity="center"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/final_gate_background"
                android:padding="12dp"
                android:layout_marginTop="12dp" />

            <!-- Soal -->
            <TextView
                android:id="@+id/tvLogic"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_outline_small"
                android:layout_marginHorizontal="20dp"
                android:text="not 1  not 🔴"
                android:gravity="center"
                android:textSize="20sp"
                android:layout_marginTop="20dp" />

            <!-- Grid Jawaban -->
            <GridLayout
                android:id="@+id/gridLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="3"
                android:rowCount="3"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true" />

            <!-- Tombol Submit -->
            <TextView
                android:id="@+id/textHasil"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:textSize="16sp"
                android:layout_marginHorizontal="20dp"
                android:text="Pilih Jawaban Sesuai Kotak"
                android:layout_marginTop="16dp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@android:color/black"
                android:background="@drawable/bg_outline_small"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
