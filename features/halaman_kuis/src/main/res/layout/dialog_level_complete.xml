<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:theme="@style/Theme.PintuLogika"
    android:gravity="center">

    <!-- Level Label -->
    <TextView
        android:id="@+id/tvLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LEVEL 1"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LEVEL COMPLETE"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_marginBottom="16dp"/>

    <!-- Result lights (Dynamic Stars) -->
    <LinearLayout
        android:id="@+id/layoutResults"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_result_box"
        android:padding="12dp"
        android:layout_marginBottom="24dp"
        android:gravity="center">

        <View
            android:id="@+id/dot1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="10dp"
            android:background="@drawable/red_dot_indicator_stroke" />

        <View
            android:id="@+id/dot2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="10dp"
            android:background="@drawable/red_dot_indicator_stroke" />

        <View
            android:id="@+id/dot3"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="10dp"
            android:background="@drawable/red_dot_indicator_stroke" />
    </LinearLayout>

    <!-- Performance Text -->
    <TextView
        android:id="@+id/tvPerformance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Excellent Performance!"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_marginBottom="16dp"
        android:visibility="gone"/>

    <!-- Retry Button -->
    <Button
        android:id="@+id/btnUlangi"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Ulangi"
        style="@style/Widget.AppCompat.Button.Colored"
        android:background="@drawable/bg_result_box"
        android:textColor="@android:color/white"
        android:paddingBottom="10dp"/>

    <!-- Navigation Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:orientation="horizontal">

        <!-- Back Button -->
        <Button
            android:id="@+id/btnKembali"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Kembali"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp"
            style="@style/Widget.AppCompat.Button.Colored"
            android:background="@drawable/bg_result_box"
            android:textColor="@android:color/white"
            android:paddingBottom="10dp"/>

        <!-- Next Button -->
        <Button
            android:id="@+id/btnSelanjutnya"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Selanjutnya"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:paddingHorizontal="20dp"
            android:paddingBottom="10dp"
            style="@style/Widget.AppCompat.Button.Colored"
            android:background="@drawable/bg_result_box"
            android:textColor="@android:color/white"/>

    </LinearLayout>

</LinearLayout>