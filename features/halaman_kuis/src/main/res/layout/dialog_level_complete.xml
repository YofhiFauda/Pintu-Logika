<?xml version="1.0" encoding="utf-8"?>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_dialog_rounded"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Level Label -->
        <TextView
            android:id="@+id/tvLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LEVEL 1"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LEVEL COMPLETE"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="16dp"/>

        <!-- Result lights -->
        <LinearLayout
            android:id="@+id/layoutResults"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_result_box"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:gravity="center">

            <View
                android:id="@+id/dot1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="10dp"
                android:background="@drawable/green_dot_indicator_stroke" />

            <View
                android:id="@+id/dot2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="10dp"
                android:background="@drawable/green_dot_indicator_stroke" />

            <View
                android:id="@+id/dot3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="10dp"
                android:background="@drawable/red_dot_indicator_stroke" />
        </LinearLayout>

        <!-- Buttons -->
        <Button
            android:id="@+id/btnKembali"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kembali"
            style="@style/Widget.AppCompat.Button.Colored"
            android:background="@drawable/bg_result_box"
            android:textColor="@android:color/white"
            android:paddingBottom="8dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnSelanjutnya"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selanjutnya"
            android:paddingHorizontal="20dp"
            android:paddingBottom="5dp"
            style="@style/Widget.AppCompat.Button.Colored"
            android:background="@drawable/bg_result_box"
            android:textColor="@android:color/white"/>
    </LinearLayout>
