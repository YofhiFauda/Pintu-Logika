<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:id="@+id/levelContainer"
    app:cardBackgroundColor="@android:color/white"
    app:cardElevation="0dp"
    android:layout_margin="8dp">


    <LinearLayout
        android:id="@+id/progressDots"
        android:layout_width="99dp"
        android:layout_height="99dp"
        android:background="@drawable/bg_button_3d_small_with_black_stroke"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layout_dotIndikator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:layout_marginTop="10dp">

            <View
                android:id="@+id/dot_indikator1"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/red_dot_indicator_stroke" />

            <View
                android:id="@+id/dot_indikator2"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:background="@drawable/red_dot_indicator_stroke" />

            <View
                android:id="@+id/dot_indikator3"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/red_dot_indicator_stroke" />
        </LinearLayout>

        <TextView
            android:id="@+id/levelNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/poppins_bold"
            android:text="1"
            android:textColor="@android:color/white"
            android:textSize="40sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
