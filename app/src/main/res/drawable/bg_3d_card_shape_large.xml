<?xml version="1.0" encoding="utf-8"?>
<!-- File: drawable/button_3d_orange.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Drop Shadow Bottom -->
    <item android:top="8dp" android:left="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- Bottom Inner Shadow Layer -->
    <item android:bottom="8dp" android:top="8dp" android:left="1dp" android:right="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#BF7D28" />
        </shape>
    </item>

    <!-- Main Orange Background -->
    <item android:top="4dp" android:bottom="12dp" android:left="1dp" android:right="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/orange_reguler" />
        </shape>
    </item>
</layer-list>
