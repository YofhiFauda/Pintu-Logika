<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.features.kuis.KuisFragment">

    <View
        android:layout_width="800dp"
        android:layout_height="400dp"
        android:translationY="-200dp"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:backgroundTint="@color/orange_reguler"
        android:background="@drawable/bg_orange_circle_shape"/>

    <!--  Start of Title  -->
    <TextView
        android:id="@+id/tvTitleHalamanKuis"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/poppins_bold"
        android:text="Tantangan\nLogika"
        android:textAlignment="viewStart"
        android:textColor="@color/white"
        android:textSize="26sp"
        app:layout_constraintBottom_toTopOf="@+id/guidelineHorizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <!--  End of Title  -->

    <LinearLayout
        android:id="@+id/card_kuisAljabarBoolean"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:gravity="center"
        android:background="@drawable/bg_3d_card_shape_large"
        android:orientation="horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guidelineHorizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_margin="20dp"
            android:layout_gravity="center_vertical">

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="80dp"
                android:layout_height="5dp"
                android:layout_gravity="top"
                app:dividerColor="@color/white"/>

            <TextView
                android:id="@+id/tv_titleAljabarBoolean"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALJABAR\nBOOLEAN"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/white"
                android:textSize="28sp"/>
        </LinearLayout>


        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="180dp"
            android:layout_weight="1">

            <View
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_orange_light_circle_shape"
                android:translationY="-100dp"
                android:translationX="50dp"/>

            <ImageView
                android:id="@+id/img_materiAljabarBoolean"
                android:layout_width="wrap_content"
                android:layout_height="180dp"
                android:layout_gravity="end"
                android:translationX="-5dp"
                android:translationY="10dp"
                android:src="@drawable/img_kuis_aljabar_boolean"/>
        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/card_kuisGerbangLogika"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:gravity="center"
        android:background="@drawable/bg_3d_card_shape_large"
        android:orientation="horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_kuisAljabarBoolean">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_margin="20dp"
            android:layout_gravity="center_vertical">

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="80dp"
                android:layout_height="5dp"
                android:layout_gravity="top"
                app:dividerColor="@color/white"/>

            <TextView
                android:id="@+id/tv_titleGerbangLogika"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GERBANG\nLOGIKA"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/white"
                android:textSize="28sp"/>
        </LinearLayout>


        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="180dp"
            android:layout_weight="1">

            <View
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_orange_light_circle_shape"
                android:translationY="-100dp"
                android:translationX="50dp"/>

            <ImageView
                android:id="@+id/img_kuisGerbangLogika"
                android:layout_width="wrap_content"
                android:layout_height="180dp"
                android:layout_gravity="end"
                android:translationX="-5dp"
                android:translationY="4dp"
                android:src="@drawable/img_kuis_gerbang_logika"/>
        </FrameLayout>

    </LinearLayout>


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_percent="0.3"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_percent="0.5"
        app:layout_constraintStart_toStartOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>